phon.field.pseudonym = Pseudonym
phon.field.nickname = Spitzname
phon.field.nicknameHelp = Nur fuer dich. Wird nirgendwohin gesendet, sodass zwei Leute namens Paul allein auf diesem Telefon unterscheidbar bleiben.
phon.field.verifyKey = Unterschriftsschluessel
phon.field.encKey = Uebertragungsschluessel
phon.field.keyHelp = Base64url, 32 Bytes.
phon.field.payload = Kontaktdaten
phon.field.relay = Relais
phon.field.relayOverride = Ihr Relais
phon.field.relayOverrideHelp = Leer lassen, um das Standardrelais dieses Telefons zu verwenden.
phon.field.verificationLevel = Wie sicher bist du, dass sie es sind?
phon.field.label = Etikett
phon.field.secret = Geheimnis
