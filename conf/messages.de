phon.field.pseudonym = Pseudonym
phon.field.nickname = Spitzname
phon.field.nicknameHelp = Nur für Sie. Wird nirgendwohin gesendet, sodass zwei Leute namens Paul allein auf diesem Telefon unterscheidbar bleiben.
phon.field.verifyKey = Unterschriftsschlüssel
phon.field.encKey = Übertragungsschlüssel
phon.field.keyHelp = Base64url, 32 Bytes.
phon.field.payload = Kontaktdaten
phon.field.relay = Relais
phon.field.relayOverride = Relais dieses Kontakts
phon.field.relayOverrideHelp = Leer lassen, um das Standardrelais dieses Telefons zu verwenden.
phon.field.verificationLevel = Wie sicher sind Sie, dass sie es sind?
phon.field.label = Etikett
phon.field.secret = Geheimen Text eingeben oder …
phon.field.secretFile = … geheimes Foto auswählen

phon.verification.veryLow = Sehr niedrig
phon.verification.low = Niedrig
phon.verification.high = Hoch
phon.verification.veryHigh = Sehr hoch
phon.verification.guidance.veryLow = Schlüssel sind angekommen, und nichts bürgt dafür, wer sie geschickt hat.
phon.verification.guidance.low = Eine unabhängige Bestätigung - ein bekannter Kanal oder eine Stimme, die Sie erkannt haben.
phon.verification.guidance.high = Zwei unabhängige Bestätigungen, getrennt geprüft.
phon.verification.guidance.veryHigh = Sie waren im selben Raum.

phon.addContact.paste = Daten einfügen
phon.addContact.manual = Daten eintippen
phon.addContact.pasteHelp = Öffnen Sie die Kontaktdaten des anderen Telefons, kopieren Sie sie und fügen Sie sie hier ein. Das ersetzt das Scannen des Codes.
phon.addContact.payloadLevelFooter = Einfügen ersetzt das Scannen und darf daher dieselbe Stufe beanspruchen - aber nur, wenn Sie die Daten wirklich von Angesicht zu Angesicht bekommen haben.
phon.addContact.manualLevelFooter = Sehr hoch gibt es hier nicht: das hiesse, Sie waren im selben Raum, und das ist Abtippen aus einem Chatfenster nicht.

phon.contacts.keyCompromised = Ein früherer Schlüssel dieses Kontakts ist als kompromittiert gemeldet
phon.contacts.awaitingRelink = {0} kennt Ihren aktuellen Schlüssel noch nicht
phon.contacts.heartbeatPaused = Lebenszeichen an diesen Kontakt sind angehalten

phon.relink.intro = Dieselbe Person, neue Schlüssel. {0} behält den Platz, sodass jeder Anteil, den Sie von ihnen verwahren, daran verankert bleibt.
phon.relink.payloadHelp = Fügen Sie ihre neuen Kontaktdaten ein oder tippen Sie die beiden Schlüssel darunter.
phon.relink.levelFooter = Wählen Sie die Stufe komplett neu. Neue Schlüssel beweisen, dass sie weiterhin einen Schlüssel kontrollieren, nicht dass sie weiterhin sie selbst sind.

phon.distributed.threshold = {0} von {1} nötig
phon.distributed.holderCount = {0,choice,1#1 Verwahrer|1<{0} Verwahrer}
phon.distributed.destroying = Warten auf Bestätigung der Verwahrer

phon.health.destroying = Wird vernichtet
phon.health.caution = Nur einer in Reserve - bald neu aufteilen
phon.health.critical = Jetzt rekonstruieren und neu aufteilen
phon.health.lost = Nicht wiederherstellbar

phon.freshness.unmonitored = Bewusst unbeobachtet
phon.freshness.gettingStale = Wird alt
phon.freshness.silentOverdue = Still - möglicher Verlust

phon.held.from = Von {0}
phon.held.sortBy = Sortieren nach
phon.held.sort.date = Datum
phon.held.sort.label = Etikett
phon.held.sort.sender = Absender

phon.requests.from = Von {0}
phon.requests.keyChanged = Dieser Schlüssel hat sich {0,choice,0#heute|1#gestern|1#vor {0} Tagen} geändert

phon.requestState.pending = Wartet
phon.requestState.approved = Zugestimmt
phon.requestState.denied = Abgelehnt
phon.requestState.withdrawn = Zurückgezogen

phon.transaction.deposit = Hinterlegung
phon.transaction.retrieval = Abruf
phon.transaction.removal = Löschung
phon.transaction.inventory = Bestand

phon.conflict.title = Möglicher Identitätsdiebstahl
phon.conflict.body = Jemand, der sich als {0} ausgibt, hat neue Schlüssel vorgelegt, unterschrieben mit einem Schlüssel, den Sie als kompromittiert gemeldet haben. Das wurde abgelehnt. Nur ein persönliches Treffen mit Neuverknüpfung bringt sie weiter.
phon.conflict.detected = Bemerkt am {0}

phon.deposit.labelPlaceholder = z. B. BitLocker-Schlüssel
phon.deposit.recipients = Wer soll einen Teil verwahren?
phon.deposit.threshold = Wie viele Teile zum Wiederzusammensetzen
phon.deposit.thresholdHelp = Weniger als das verrät überhaupt nichts.
phon.deposit.fileHelp = PNG oder JPEG. Füllen Sie eines von beiden aus, nicht beides.
phon.deposit.sizeLimit = Bis zu {0} KiB. Hier nur Text - die Apps können auch ein Foto aufteilen.

phon.shareDetail.holder = Verwahrt von {0}
phon.shareDetail.deposited = Hinterlegt am {0}
phon.shareDetail.requestedAt = Angefragt am {0}
phon.shareDetail.noRequest = Noch nichts angefragt

phon.secretDetail.holders = Verwahrer
phon.secretDetail.approvedCount = {0} von {1} nötigen haben ihren Teil zurückgegeben
phon.secretDetail.retrieveDisabled.allAsked = Alle Verwahrer wurden bereits gefragt.
phon.secretDetail.retrieveDisabled.destroying = Dieses Geheimnis wird gerade vernichtet.
phon.secretDetail.reconstructDisabled = {0,choice,1#Ein weiterer Verwahrer muss|1<{0} weitere Verwahrer müssen} den Teil noch zurückgeben.
phon.secretDetail.clearDisabled = Bisher wurde nichts zurückgegeben.
phon.secretDetail.clearReminder = Die gesammelten Kopien nach Gebrauch freigeben - die Verwahrer behalten ihre Teile in jedem Fall.

phon.reconstruct.noMargin = Genau genug Teile, also hat nichts sie gegengeprüft.
phon.reconstruct.confirmed = Mehr Teile als nötig, und alle stimmten überein.
phon.reconstruct.excluded = {0,choice,1#Ein Teil wich ab und wurde|1<{0} Teile wichen ab und wurden} ausgeschlossen.
phon.reconstruct.opaque = {0}, {1} Bytes - phon kann diese Art Geheimnis nicht anzeigen.
phon.reconstruct.failed = Konnte nicht zusammengesetzt werden: {0}

phon.repair.gathering = {0} Teile nötig, {1} bisher zurückgegeben.
phon.repair.notRequested = Nicht angefragt
phon.repair.needMore = Fragen Sie die übrigen Verwahrer und kommen Sie wieder, sobald genug zugestimmt haben.
phon.repair.redeposit = Erneut aufteilen
phon.repair.redepositHelp = Wählen Sie einen frischen Satz Verwahrer. Das Vernichten der alten Verteilung bleibt ein eigener Schritt auf dem vorigen Bildschirm.

phon.qr.payload = Kontaktdaten
phon.qr.help = Ein anderes Phony-Phone fügt das ein. Ein echtes Handy kann stattdessen den Code darunter scannen.

phon.settings.relay = Standardrelais
phon.settings.relayHelp = Wohin dieses Telefon hinterlegt und abholt, sofern ein Kontakt kein eigenes Relais mitbringt.
phon.settings.relaySaved = Gespeichert.
phon.settings.identity = Identität
phon.settings.identitySince = In Gebrauch seit
phon.settings.unknown = unbekannt
phon.settings.regenerateHelp = Erzeugt neue Schlüssel und sagt es jedem Kontakt, unterschrieben mit den Schlüsseln, die ersetzt werden. Wer nicht erreicht wird, erfährt es nicht von allein.
phon.settings.regenerated = {0} von {1} Kontakten benachrichtigt.
phon.settings.regeneratedDrainFailed = Ein Teil des Relaisverkehrs konnte vorher nicht abgeholt werden; er kommt bei einem späteren Abruf an.
phon.settings.appearance = Darstellung
phon.settings.darkMode = Dunkel
phon.settings.dangerZone = Gefahrenzone
phon.settings.forgetHelp = Setzt dieses Phony-Phone komplett zurück: Schlüssel, Kontakte, Geheimnisse und jeden verwahrten Anteil.

phon.confirm.deleteContact = {0} löschen? Was sie für Sie verwahren, bleibt bei ihnen.
phon.confirm.markCompromised = Den aktuellen Schlüssel von {0} als kompromittiert melden? Danach wird kein damit unterschriebener Schlüsselwechsel mehr von allein akzeptiert.
phon.confirm.deleteHeld = Diesen Anteil nicht mehr verwahren? Der Eigentümerin fehlt dann ein Teil, und sie kann ihn später nicht mehr bei Ihnen abrufen.
phon.confirm.deleteAllHeld = Alle {1} Anteile von {0} nicht mehr verwahren?
phon.confirm.clearCollected.unread = Das Geheimnis wurde hier noch nicht angezeigt. Werden die gesammelten Kopien freigegeben, müssen die Verwahrer erneut gefragt werden, bevor es wieder zusammengesetzt werden kann.
phon.confirm.clearCollected.afterReading = Die Verwahrer behalten ihre Teile - Kopien lassen sich jederzeit erneut anfragen.
phon.confirm.destroy = Dieses Geheimnis vernichten? Alle {0} Verwahrer werden gebeten, ihren Teil zu vernichten. Sobald alle es getan haben, kann es nie wieder zusammengesetzt werden.
phon.confirm.forceForget = Dieses Geheimnis vergessen, ohne auf die übrigen Verwahrer zu warten?
phon.confirm.regenerate = Identität neu erzeugen und Ihre {0} Kontakte benachrichtigen?
phon.confirm.forgetIdentity = Dieses Phony-Phone komplett zurücksetzen?

phon.error.verificationLevel = Wählen Sie, wie sicher Sie sind.
phon.error.blankContact = Einer der gewählten Kontakte ist leer.
phon.error.thresholdAboveHolders = Es werden mehr Teile verlangt, als es Verwahrer gibt.
phon.error.secretMissing = Tippen Sie ein Geheimnis oder wählen Sie ein Bild.
phon.error.secretAmbiguous = Sie haben Text und ein Bild angegeben. Leeren Sie eines davon - phon wählt nicht für Sie.
phon.error.unsupportedType = Nur PNG und JPEG lassen sich aufteilen. Diese Datei ist keines von beiden, gemessen an ihrem Inhalt und nicht an ihrem Namen.
phon.error.relinkEmpty = fügen Sie ihre Daten ein oder tippen Sie beide Schlüssel.
