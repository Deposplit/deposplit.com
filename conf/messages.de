phon.signIn.subtitle = Waehle ein Pseudonym
phon.signIn.placeholder = z. B. Alice
phon.signIn.help = Pseudonyme muessen nicht eindeutig sein, und du darfst deins frei weitergeben - es ist kein Login.
phon.signIn.port = Dieses Scheintelefon ist {0}. Starte ein weiteres auf einem anderen Port, um eine zweite Person zu spielen.

phon.advisory.awaitingRelink = {0,choice,1#Ein Kontakt hat noch|1<{0} Kontakte haben noch} deinen alten Schluessel - triff sie und lass sie deinen Code erneut scannen
phon.advisory.relayUnreachable = Relais nicht erreichbar

phon.empty.distributed = Du hast noch nichts aufgeteilt
phon.empty.held = Du verwahrst noch nichts
phon.empty.requests = Niemand wartet auf dich
phon.empty.contacts = Noch keine Kontakte
phon.empty.depositNoContacts = Lege zuerst einen Kontakt an - ein Geheimnis braucht jemanden, der es verwahrt
phon.qr.noKeys = Dieses Telefon hat keine Schluessel zum Anzeigen

