phon.verification.veryLow = Sehr niedrig
phon.verification.low = Niedrig
phon.verification.high = Hoch
phon.verification.veryHigh = Sehr hoch
phon.verification.guidance.veryLow = Schluessel sind angekommen, und nichts buergt dafuer, wer sie geschickt hat.
phon.verification.guidance.low = Eine unabhaengige Bestaetigung - ein bekannter Kanal oder eine Stimme, die du erkannt hast.
phon.verification.guidance.high = Zwei unabhaengige Bestaetigungen, getrennt geprueft.
phon.verification.guidance.veryHigh = Ihr wart im selben Raum.

phon.addContact.paste = Daten einfuegen
phon.addContact.manual = Schluessel tippen
phon.addContact.pasteHelp = Oeffne die Kontaktdaten des anderen Telefons, kopiere sie und fuege sie hier ein. Das ersetzt das Scannen des Codes.
phon.addContact.payloadLevelFooter = Einfuegen ersetzt das Scannen und darf daher dieselbe Stufe beanspruchen - aber nur, wenn du die Daten wirklich von Angesicht zu Angesicht bekommen hast.
phon.addContact.manualLevelFooter = Sehr hoch gibt es hier nicht: das hiesse, ihr wart im selben Raum, und das ist Abtippen aus einem Chatfenster nicht.

phon.contacts.keyCompromised = Ein frueherer Schluessel dieses Kontakts ist als kompromittiert gemeldet
phon.contacts.awaitingRelink = {0} kennt deinen aktuellen Schluessel noch nicht
phon.contacts.heartbeatPaused = Lebenszeichen an diesen Kontakt sind angehalten

phon.relink.intro = Dieselbe Person, neue Schluessel. {0} behaelt den Platz, sodass jeder Anteil, den du von ihnen verwahrst, daran verankert bleibt.
phon.relink.payloadHelp = Fuege ihre neuen Kontaktdaten ein oder tippe die beiden Schluessel darunter.
phon.relink.levelFooter = Waehle die Stufe komplett neu. Neue Schluessel beweisen, dass sie weiterhin einen Schluessel kontrollieren, nicht dass sie weiterhin sie selbst sind.

phon.distributed.threshold = {0} von {1} noetig
phon.distributed.discarding = Warten auf Bestaetigung der Inhaber

phon.health.discarding = Wird verworfen
phon.health.caution = Nur einer in Reserve - bald neu aufteilen
phon.health.critical = Jetzt rekonstruieren und neu aufteilen
phon.health.lost = Nicht wiederherstellbar

phon.freshness.unmonitored = Bewusst unbeobachtet
phon.freshness.gettingStale = Wird alt
phon.freshness.silentOverdue = Still - moeglicher Verlust

phon.held.from = Von {0}
phon.held.sort.date = Datum
phon.held.sort.label = Etikett
phon.held.sort.sender = Absender

phon.requests.from = Von {0}
phon.requests.keyChanged = Dieser Schluessel hat sich {0,choice,0#heute|1#gestern|1#vor {0} Tagen} geaendert

phon.requestState.pending = Wartet
phon.requestState.approved = Zugestimmt
phon.requestState.denied = Abgelehnt
phon.requestState.withdrawn = Zurueckgezogen

phon.transaction.deposit = Hinterlegung
phon.transaction.retrieval = Abruf
phon.transaction.removal = Loeschung
phon.transaction.inventory = Bestand

phon.conflict.title = Moeglicher Identitaetsdiebstahl
phon.conflict.body = Jemand, der sich als {0} ausgibt, hat neue Schluessel vorgelegt, unterschrieben mit einem Schluessel, den du als kompromittiert gemeldet hast. Das wurde abgelehnt. Nur ein persoenliches Treffen mit Neuverknuepfung bringt sie weiter.
phon.conflict.detected = Bemerkt am {0}

phon.deposit.labelPlaceholder = z. B. BitLocker-Schluessel
phon.deposit.recipients = Wer soll einen Teil verwahren?
phon.deposit.threshold = Wie viele Teile zum Wiederzusammensetzen
phon.deposit.thresholdHelp = Weniger als das verraet ueberhaupt nichts.
phon.deposit.fileHelp = PNG oder JPEG. Fuelle eines von beiden aus, nicht beides.
phon.deposit.sizeLimit = Bis zu {0} KiB. Hier nur Text - die Apps koennen auch ein Foto aufteilen.

phon.shareDetail.holder = Verwahrt von {0}
phon.shareDetail.deposited = Hinterlegt am {0}
phon.shareDetail.requestedAt = Angefragt am {0}
phon.shareDetail.noRequest = Noch nichts angefragt
phon.shareDetail.reconstruct = Geheimnis wieder zusammensetzen
phon.shareDetail.approvedCount = {0} von {1} noetigen haben ihren Teil zurueckgegeben

phon.reconstruct.noMargin = Genau genug Teile, also hat nichts sie gegengeprueft.
phon.reconstruct.confirmed = Mehr Teile als noetig, und alle stimmten ueberein.
phon.reconstruct.excluded = {0,choice,1#Ein Teil wich ab und wurde|1<{0} Teile wichen ab und wurden} ausgeschlossen.
phon.reconstruct.opaque = {0}, {1} Bytes - phon kann diese Art Geheimnis nicht anzeigen.
phon.reconstruct.failed = Konnte nicht zusammengesetzt werden: {0}

phon.repair.gathering = {0} Teile noetig, {1} bisher zurueckgegeben.
phon.repair.notRequested = Nicht angefragt
phon.repair.needMore = Frage die uebrigen Inhaber und komm wieder, sobald genug zugestimmt haben.
phon.repair.redeposit = Erneut aufteilen
phon.repair.redepositHelp = Waehle einen frischen Satz Inhaber. Das Verwerfen der alten Verteilung bleibt ein eigener Schritt auf dem vorigen Bildschirm.

phon.qr.payload = Kontaktdaten
phon.qr.help = Ein anderes Scheintelefon fuegt das ein. Ein echtes Handy kann stattdessen den Code darunter scannen.

phon.settings.relay = Standardrelais
phon.settings.relayHelp = Wohin dieses Telefon hinterlegt und abholt, sofern ein Kontakt kein eigenes Relais mitbringt.
phon.settings.relaySaved = Gespeichert.
phon.settings.identity = Identitaet
phon.settings.identitySince = In Gebrauch seit
phon.settings.unknown = unbekannt
phon.settings.regenerateHelp = Erzeugt neue Schluessel und sagt es jedem Kontakt, unterschrieben mit den Schluesseln, die ersetzt werden. Wer nicht erreicht wird, erfaehrt es nicht von allein.
phon.settings.regenerated = {0} von {1} Kontakten benachrichtigt.
phon.settings.regeneratedDrainFailed = Ein Teil des Relaisverkehrs konnte vorher nicht abgeholt werden; er kommt bei einem spaeteren Abruf an.
phon.settings.appearance = Darstellung
phon.settings.darkMode = Dunkel
phon.settings.dangerZone = Gefahrenzone
phon.settings.forgetHelp = Setzt dieses Scheintelefon komplett zurueck: Schluessel, Kontakte, Geheimnisse und jeden verwahrten Anteil.

phon.confirm.deleteContact = {0} loeschen? Was sie fuer dich verwahren, bleibt bei ihnen.
phon.confirm.markCompromised = Den aktuellen Schluessel von {0} als kompromittiert melden? Danach wird kein damit unterschriebener Schluesselwechsel mehr von allein akzeptiert.
phon.confirm.deleteHeld = Diesen Anteil nicht mehr verwahren? Der Eigentuemerin fehlt dann ein Teil, und sie kann ihn spaeter nicht mehr bei dir abrufen.
phon.confirm.deleteAllHeld = Alle {1} Anteile von {0} nicht mehr verwahren?
phon.confirm.discard = Alle {0} Inhaber bitten, ihren Teil zu loeschen?
phon.confirm.forceForget = Dieses Geheimnis vergessen, ohne auf die uebrigen Inhaber zu warten?
phon.confirm.regenerate = Identitaet neu erzeugen und deine {0} Kontakte benachrichtigen?
phon.confirm.forgetIdentity = Dieses Scheintelefon komplett zuruecksetzen?

phon.error.verificationLevel = Waehle, wie sicher du bist.
phon.error.blankContact = Einer der gewaehlten Kontakte ist leer.
phon.error.thresholdAboveHolders = Es werden mehr Teile verlangt, als es Inhaber gibt.
phon.error.secretMissing = Tippe ein Geheimnis oder waehle ein Bild.
phon.error.secretAmbiguous = Du hast Text und ein Bild angegeben. Leere eines davon - phon waehlt nicht fuer dich.
phon.error.unsupportedType = Nur PNG und JPEG lassen sich aufteilen. Diese Datei ist keines von beiden, gemessen an ihrem Inhalt und nicht an ihrem Namen.
phon.error.relinkEmpty = Fuege ihre Daten ein oder tippe beide Schluessel.
