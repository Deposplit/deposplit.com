# https://www.playframework.com/documentation/latest/ScalaRouting

# Landing page
GET     /                                controllers.gui.HomeController.index()

# REST API for the native apps — all share interactions go through /share-requests
POST    /share-requests                  controllers.api.ShareRequestsController.openShareRequest()
GET     /share-requests                  controllers.api.ShareRequestsController.listShareRequests()
GET     /share-requests/:requestId       controllers.api.ShareRequestsController.getShareRequest(requestId: String)
PATCH   /share-requests/:requestId       controllers.api.ShareRequestsController.respondToShareRequest(requestId: String)
DELETE  /share-requests/:requestId       controllers.api.ShareRequestsController.deleteShareRequest(requestId: String)
DELETE  /share-requests                  controllers.api.ShareRequestsController.deleteShareRequests()
POST    /share-requests/withdraw         controllers.api.ShareRequestsController.withdrawShareRequests()

# Item 9's signed rotate(K_old -> K_new) push — not a share request, see KeyRotationsController
POST    /key-rotations                   controllers.api.KeyRotationsController.pushRotation()
GET     /key-rotations                   controllers.api.KeyRotationsController.listRotations()
DELETE  /key-rotations/:id               controllers.api.KeyRotationsController.deleteRotation(id: String)

# … but also for the Web-based emulator/simulator
->      /phonyPhone                      phon.Routes

# Static assets
GET     /assets/*file                    controllers.Assets.versioned(path="/public", file: Asset)

# Static assets in Markdown
GET     /*markdownFilePath               controllers.gui.MarkdownController.get(markdownFilePath: controllers.gui.MarkdownFilePath, embedded: Boolean ?= true)
